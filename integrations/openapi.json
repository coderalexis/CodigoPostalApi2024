{
  "components": {
    "schemas": {
      "AddressOptions": {
        "properties": {
          "federal_entity": {
            "type": "string"
          },
          "federal_entity_code": {
            "type": "string"
          },
          "municipality": {
            "type": "string"
          },
          "municipality_code": {
            "type": "string"
          },
          "settlements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "zip_code": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "AddressValidationRequest": {
        "properties": {
          "federal_entity": {
            "example": "Ciudad de México",
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "municipality": {
            "example": "Álvaro Obregón",
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "zip_code": {
            "example": "01000",
            "minLength": 1,
            "pattern": "[0-9]{5}",
            "type": "string"
          }
        },
        "required": [
          "federal_entity",
          "municipality",
          "zip_code"
        ],
        "type": "object"
      },
      "AddressValidationResult": {
        "properties": {
          "canonical": {
            "$ref": "#/components/schemas/AddressOptions"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/AddressOptions"
            },
            "type": "array"
          },
          "suggestions_truncated": {
            "type": "boolean"
          },
          "total_suggestions": {
            "format": "int32",
            "type": "integer"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FederalEntity": {
        "properties": {
          "municipalities_count": {
            "format": "int32",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "zip_codes_count": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PagedResponse": {
        "properties": {
          "content": {
            "items": {},
            "type": "array"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "pageNumber": {
            "format": "int32",
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Settlements": {
        "properties": {
          "name": {
            "type": "string"
          },
          "settlement_type": {
            "type": "string"
          },
          "zone_type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ZipCode": {
        "properties": {
          "federal_entity": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "municipality": {
            "type": "string"
          },
          "settlements": {
            "items": {
              "$ref": "#/components/schemas/Settlements"
            },
            "type": "array"
          },
          "zip_code": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ZipCodeStats": {
        "properties": {
          "catalogChecksum": {
            "type": "string"
          },
          "catalogSource": {
            "type": "string"
          },
          "loadedAt": {
            "format": "date-time",
            "type": "string"
          },
          "totalFederalEntities": {
            "format": "int32",
            "type": "integer"
          },
          "totalMunicipalities": {
            "format": "int32",
            "type": "integer"
          },
          "totalSettlements": {
            "format": "int64",
            "type": "integer"
          },
          "totalZipCodes": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "email": "coderalexis@gmail.com",
      "name": "Jose Alexis",
      "url": "https://www.coderalexis.com"
    },
    "description": "Consulta códigos postales mexicanos, valida la relación CP/estado/municipio\ny obtiene opciones de domicilio para formularios. Los nombres se comparan\nsin acentos ni distinción de mayúsculas. No verifica calles ni números.\nConsulta /zip-codes/stats para identificar el catálogo activo y sus totales.\nLos límites de peticiones se comunican mediante X-RateLimit-* y Retry-After.\n",
    "license": {
      "name": "Licencia MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "title": "API de Códigos Postales de México",
    "version": "3.0.0-SNAPSHOT"
  },
  "openapi": "3.1.0",
  "paths": {
    "/zip-codes": {
      "get": {
        "description": "Busca códigos postales por entidad federativa con paginación automática.\n\n### Características:\n- ✅ Búsqueda parcial (ej: \"mex\" encuentra \"México\", \"Nuevo México\")\n- ✅ Insensible a acentos (\"Mexico\" = \"México\")\n- ✅ Insensible a mayúsculas\n- ✅ Resultados paginados\n",
        "operationId": "searchByFederalEntity",
        "parameters": [
          {
            "description": "Término de búsqueda para la entidad federativa (puede ser parcial)",
            "example": "mexico",
            "in": "query",
            "name": "federal_entity",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Número de página (comienza en 0)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Tamaño de página",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponse"
                }
              }
            },
            "description": "Lista de códigos postales que coinciden"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Parámetros de búsqueda inválidos"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No se encontraron códigos postales"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Límite de peticiones alcanzado; espera Retry-After segundos",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta el siguiente token",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "🗺️ Buscar por entidad federativa (estado)",
        "tags": [
          "Búsqueda por Ubicación"
        ]
      }
    },
    "/zip-codes/advanced": {
      "get": {
        "description": "Búsqueda con múltiples filtros combinados.\n\n### Filtros disponibles:\n- `federal_entity` - Entidad federativa (estado)\n- `municipality` - Municipio\n- `settlement` - Nombre de colonia/asentamiento\n- `settlement_type` - Tipo de asentamiento (Colonia, Fraccionamiento, etc.)\n- `zone_type` - Tipo de zona (Urbano, Rural)\n",
