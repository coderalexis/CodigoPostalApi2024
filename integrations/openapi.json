    "/zip-codes/validate-address": {
      "post": {
        "description": "Coincidencia exacta ignorando acentos, mayúsculas y espacios exteriores. Una inconsistencia devuelve 200 con valid=false y hasta cinco alternativas. No verifica calles ni números exteriores.",
        "operationId": "validateAddress",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AddressValidationResult"
                }
              }
            },
            "description": "Resultado de validación"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Solicitud inválida"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Límite de peticiones alcanzado; espera Retry-After segundos",
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta el siguiente token",
                "schema": {
                  "format": "int32",
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Validar CP, estado y municipio",
        "tags": [
          "Domicilios"
        ]
      }
    },
    "/zip-codes/{zipcode}": {
      "get": {
        "description": "Obtiene información completa de un código postal específico incluyendo:\n- Entidad federativa\n- Municipio\n- Localidad\n- Lista de asentamientos (colonias, fraccionamientos, etc.)\n\n### Ejemplos de uso:\n- `01000` - San Ángel, Ciudad de México\n- `44100` - Guadalajara Centro, Jalisco\n- `64000` - Monterrey Centro, Nuevo León\n\n### Rendimiento:\nEste endpoint está optimizado con caché, tiempo de respuesta típico: **~50ms**\n",
        "operationId": "getZipCode",
        "parameters": [
          {
            "description": "El código postal a buscar",
            "example": "01000",
            "in": "path",
            "name": "zipcode",
            "required": true,
            "schema": {
              "pattern": "\\d{5}",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZipCode"
                }
              }
