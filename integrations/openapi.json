              "type": "string"
            }
          },
          {
            "description": "Tipo de asentamiento",
            "in": "query",
            "name": "settlement_type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Tipo de zona (Urbano/Rural)",
            "in": "query",
