    "/zip-codes/search": {
      "get": {
        "description": "Busca códigos postales que inicien con el prefijo proporcionado.\nIdeal para implementar autocompletado.\n",
        "operationId": "searchByPartialCode",
        "parameters": [
          {
            "description": "Código postal parcial (solo dígitos)",
            "example": "010",
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "minLength": 1,
              "pattern": "\\d{1,5}",
              "type": "string"
            }
          },
          {
            "description": "Número máximo de resultados (1-50)",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Si es true, devuelve formato simplificado",
            "in": "query",
            "name": "simplified",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ZipCode"
