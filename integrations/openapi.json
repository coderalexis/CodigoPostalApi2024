            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Número de página",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
