    {
      "name": "ETag",
      "item": [
        {
          "name": "1. Capturar ETag",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/zip-codes/01000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON válido', () => pm.response.json());",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));",
                  "pm.test('ETag presente', () => pm.expect(pm.response.headers.get('ETag')).to.be.a('string')); "
                ]
              }
            }
          ]
        },
        {
          "name": "2. Revalidar el mismo recurso",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "If-None-Match",
                "value": "{{etag}}"
              }
            ],
            "url": "{{baseUrl}}/zip-codes/01000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 304', () => pm.response.to.have.status(304));",
                  "pm.test('Sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        },
